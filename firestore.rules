rules_version = '2';

// Regras de segurança da Agenda do Cadete.
// O banco guarda SÓ e-mails liberados e pedidos de acesso. Nenhuma agenda.
// Administrador: o mesmo e-mail de firebase-config.js.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function admin() {
      return logado() && request.auth.token.email in ['otaviosilva.oe@gmail.com'];
    }
    function eu(email) {
      return logado() && request.auth.token.email == email;
    }

    // Lista de acessos: cada pessoa lê só o próprio status; só o admin altera.
    match /acessos/{email} {
      allow get: if admin() || eu(email);
      allow list, write: if admin();
    }

    // Pedidos de acesso: a pessoa cria o próprio pedido; o admin vê e apaga.
    match /pedidos/{email} {
      allow create: if eu(email) && request.resource.data.keys().hasOnly(['email', 'criadoEm'])
                    && request.resource.data.email == email;
      allow get: if admin() || eu(email);
      allow list, delete: if admin();
    }

    // Qualquer outro caminho: bloqueado.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
