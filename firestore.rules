rules_version = '2';

// Regras de segurança da Agenda do Cadete.
// Princípio: cada cadete só lê e grava o que é dele. A agenda (cofres) e os
// textos dos lembretes (push) vão CRIPTOGRAFADOS com a senha do próprio cadete:
// nem o administrador consegue ler.
// Administrador: o mesmo e-mail de firebase-config.js.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function meuEmail() {
      return request.auth.token.email;
    }
    function admin() {
      return logado() && meuEmail() in ['otaviosilva.oe@gmail.com'];
    }
    function eu(email) {
      return logado() && meuEmail() == email;
    }
    // conta liberada pelo administrador (ou o próprio administrador)
    function liberado() {
      return admin() || (logado()
        && exists(/databases/$(database)/documents/acessos/$(meuEmail()))
        && get(/databases/$(database)/documents/acessos/$(meuEmail())).data.ativo == true);
    }
    function escalante() {
      return admin() || (liberado()
        && get(/databases/$(database)/documents/acessos/$(meuEmail())).data.get('papel', '') == 'escalante');
    }
    function so(campos) {
      return request.resource.data.keys().hasOnly(campos);
    }
    function mudou(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // Lista de acessos: cada pessoa lê só o próprio status; só o admin altera.
    match /acessos/{email} {
      allow get: if admin() || eu(email);
      allow list, write: if admin();
    }

    // Pedidos de acesso: a pessoa cria o próprio pedido; o admin vê e apaga.
    match /pedidos/{email} {
      allow create: if eu(email) && so(['email', 'criadoEm']) && request.resource.data.email == email;
      allow get: if admin() || eu(email);
      allow list, delete: if admin();
    }

    // Cópia criptografada da agenda: só o dono (o admin NÃO lê).
    match /cofres/{uid} {
      allow read, delete: if liberado() && request.auth.uid == uid;
      allow create, update: if liberado() && request.auth.uid == uid
        && so(['iv', 'dados', 'temPar', 'atualizadoEm'])
        && request.resource.data.dados.size() < 900000;
    }

    // Lembretes com o app fechado: tokens do aparelho + horários e texto criptografado.
    // Quem envia é a rotina automática (conta de serviço), que ignora estas regras.
    match /push/{uid} {
      allow read, delete: if liberado() && request.auth.uid == uid;
      allow create, update: if liberado() && request.auth.uid == uid
        && so(['uid', 'tokens', 'itens', 'atualizadoEm', 'enviadoAte'])
        && request.resource.data.uid == uid;
      allow list: if admin(); // só para contar aparelhos nas estatísticas
    }

    // Perfil público dentro da turma (só de quem decide participar).
    match /perfis/{email} {
      allow read: if liberado();
      allow create, update: if liberado() && eu(email)
        && so(['email', 'nome', 'nomeGuerra', 'turma', 'pub', 'atualizadoEm'])
        && request.resource.data.email == email
        && request.resource.data.turma is string && request.resource.data.turma.size() <= 40;
      allow delete: if eu(email) || admin();
    }

    // Mural de avisos: o admin publica; todos os liberados leem.
    match /avisos/{id} {
      allow read: if liberado();
      allow write: if admin();
    }

    // Trocas de serviço: só entre colegas da MESMA turma; só os dois envolvidos leem.
    match /trocas/{id} {
      allow read: if liberado() && (resource.data.de == meuEmail() || resource.data.para == meuEmail());
      allow create: if liberado()
        && request.resource.data.de == meuEmail()
        && request.resource.data.para != meuEmail()
        && request.resource.data.status == 'pendente'
        && so(['de', 'para', 'turma', 'deNome', 'paraNome', 'pubDe', 'pubPara', 'iv', 'dados', 'status', 'criadoEm', 'atualizadoEm'])
        && exists(/databases/$(database)/documents/perfis/$(meuEmail()))
        && exists(/databases/$(database)/documents/perfis/$(request.resource.data.para))
        && get(/databases/$(database)/documents/perfis/$(meuEmail())).data.turma == request.resource.data.turma
        && get(/databases/$(database)/documents/perfis/$(request.resource.data.para)).data.turma == request.resource.data.turma;
      // quem recebeu aceita/recusa; quem pediu cancela
      allow update: if liberado() && mudou(['status', 'atualizadoEm']) && (
          (resource.data.para == meuEmail() && resource.data.status == 'pendente' && request.resource.data.status in ['aceita', 'recusada'])
          || (resource.data.de == meuEmail() && resource.data.status in ['pendente', 'aceita'] && request.resource.data.status == 'cancelada'));
      allow delete: if liberado() && (resource.data.de == meuEmail() || resource.data.para == meuEmail());
    }

    // Escalas da turma: o escalante (ou o admin) publica; todos os liberados leem.
    match /escalas/{id} {
      allow read: if liberado();
      allow create: if escalante() && request.resource.data.publicadoPor == meuEmail()
        && so(['tipo', 'titulo', 'linhas', 'publicadoPor', 'criadoEm']);
      allow delete: if admin() || (escalante() && resource.data.publicadoPor == meuEmail());
    }

    // Último acesso (estatística sem conteúdo): cada um grava o seu; só o admin lê.
    match /atividade/{email} {
      allow create, update: if liberado() && eu(email) && so(['ultimoAcesso', 'dia', 'plataforma', 'instalado', 'versao']);
      allow read: if admin();
    }

    // Qualquer outro caminho: bloqueado.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
